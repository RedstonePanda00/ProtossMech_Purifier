    <RecipeDef ParentName="AmmoRecipeBase">
        <defName>MakePM_Ammo_R42DeadEye_Short</defName>
        <label>make W-5Re penetrator 8×80mm x17</label>
        <description>Print 17 W-5Re penetrator 8×80mm rounds from one unit of Solarite.</description>
        <jobString>Making W-5Re penetrator 8×80mm rounds.</jobString>
        <researchPrerequisites><li>PM_Fundamentals</li><li>ChargedShot</li></researchPrerequisites>
        <recipeUsers Inherit="false">
            <li>ProtossForge</li>
        </recipeUsers>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>PM_Solarite</li>
                    </thingDefs>
                </filter>
                <count>1</count>
            </li>
        </ingredients>
        <fixedIngredientFilter>
            <thingDefs>
                <li>PM_Solarite</li>
            </thingDefs>
        </fixedIngredientFilter>
        <products>
            <PM_Ammo_R42DeadEye_Short>17</PM_Ammo_R42DeadEye_Short>
        </products>
        <workAmount>2500</workAmount>
    </RecipeDef>

