<Defs>

    <CombatExtended.AmmoCategoryDef>
        <defName>PM_R42RailSlug_Short</defName>
        <label>W-5Re penetrator 8×80mm</label>
        <labelShort>8×80 AP</labelShort>
        <description>A fin-stabilized penetrator made primarily of W-5Re alloy, with multiple parallel armatures made from the same room-temperature superconducting material as the R42 rails, and a superconducting composite coating. This projectile measures 8×80mm.</description>
