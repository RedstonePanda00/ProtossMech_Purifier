<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Preserve the original body topology and part order for saved injury indices. -->
  <BodyPartDef><defName>PM_NaniteHead</defName><label>head</label><hitPoints>30</hitPoints><permanentInjuryChanceFactor>0</permanentInjuryChanceFactor><skinCovered>false</skinCovered><solid>true</solid><bleedRate>0</bleedRate><alive>false</alive><tags><li>TalkingSource</li></tags></BodyPartDef>
