<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThingDef ParentName="BaseBullet">
        <defName>PM_Bullet_C7Templar_APEX_MicroMissile</defName>
        <label>5.8x42 micro-missile</label>
        <description>The 5.8x42mm micro-missile follows instructions from a miniature supercomputer to seek out and lock onto an enemy's head. Its plasma-filled warhead bursts on impact, inflicting secondary ionizing radiation and blast damage.</description>
        <thingClass>ProtossMech.Bullet_C7TemplarApexMicroMissile</thingClass>
        <graphicData>
            <texPath>Things/Projectile/Bullet_Small</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(0.45,0.45)</drawSize>
        </graphicData>
        <comps>
            <li Class="ProtossMech.CompProperties_C7ApexSmartMissile"/>
        </comps>
        <projectile>
            <damageDef>Bullet</damageDef>
            <damageAmountBase>14</damageAmountBase>
            <speed>80</speed>
            <armorPenetrationBase>0.42</armorPenetrationBase>
            <stoppingPower>1.0</stoppingPower>
        </projectile>
    </ThingDef>

</Defs>
