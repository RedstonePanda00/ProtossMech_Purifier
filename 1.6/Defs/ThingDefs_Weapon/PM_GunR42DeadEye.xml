<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThingDef ParentName="BaseBullet">
        <defName>PM_Bullet_R42_Short</defName>
        <label>W-5Re penetrator 8×80mm</label>
        <description>A fin-stabilized penetrator made primarily of W-5Re alloy, with multiple parallel armatures and a superconducting composite coating. This projectile measures 8×80mm.</description>
        <thingClass>ProtossMech.Bullet_RailDeadEye</thingClass>
        <graphicData>
            <texPath>Things/Weapon/RailGun/R42Projectile</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <projectile>
            <damageDef>Bullet</damageDef>
            <damageAmountBase>20</damageAmountBase>
            <speed>240</speed>
            <armorPenetrationBase>1.26</armorPenetrationBase>
            <stoppingPower>2.2</stoppingPower>
        </projectile>
    </ThingDef>

