    <ThingDef ParentName="BaseGun">
        <defName>PM_GunR42DeadEye</defName>
        <thingClass>GunSmithFramework.Thing_ModularGun</thingClass>
        <label>R-42 DeadEye</label>
        <description>An enhanced anti-materiel railgun that uses multiple sets of parallel rails and superconducting coils to accelerate its projectile simultaneously. It is powered by a compact solarite battery. The R42 offers excellent long-range accuracy and exceptional armor penetration.\n\nIt is printed as a complete weapon aboard the Aurora, with its replicator converting energy directly into matter.</description>
        <techLevel>Spacer</techLevel>
        <smeltable>false</smeltable>
        <destroyOnDrop>false</destroyOnDrop>
        <graphicData>
            <texPath>Things/Weapon/RailGun/R42_Body</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(2.2, 2.2)</drawSize>
        </graphicData>
        <statBases>
            <Flammability>0</Flammability>
            <MarketValue>2400</MarketValue>
            <Mass>8.5</Mass>
            <AccuracyTouch>0.75</AccuracyTouch>
            <AccuracyShort>0.75</AccuracyShort>
            <AccuracyMedium>0.85</AccuracyMedium>
            <AccuracyLong>0.92</AccuracyLong>
            <RangedWeapon_Cooldown>0.35</RangedWeapon_Cooldown>
        </statBases>
        <weaponTags>
            <li>PM_R42_DeadEye</li>
        </weaponTags>
        <comps>
            <li Class="GunSmithFramework.CompProperties_ModularGun">
                <platformDef>PM_GunSmith_R42</platformDef>
            </li>
        </comps>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>PM_Bullet_RailDeadEye</defaultProjectile>
                <warmupTime>1.8</warmupTime>
                <range>42</range>
                <burstShotCount>1</burstShotCount>
                <soundCast>ChargeLance_Fire</soundCast>
                <soundCastTail>GunTail_Heavy</soundCastTail>
                <muzzleFlashScale>9</muzzleFlashScale>
            </li>
        </verbs>
        <tools>
            <li>
                <label>stock</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>12</power>
                <cooldownTime>2</cooldownTime>
            </li>
        </tools>
    </ThingDef>

</Defs>
