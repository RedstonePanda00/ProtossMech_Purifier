<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BaseBullet">
    <defName>PM_Projectile_Common_UB_HE</defName>
    <label>underbarrel fragmentation grenade</label>
    <thingClass>ProtossMech.GunSmith.Projectile_UnderbarrelFrag</thingClass>
    <modExtensions><li Class="ProtossMech.GunSmith.UnderbarrelGrenadeProperties"><fragmentCount>20</fragmentCount><fragmentRange>7</fragmentRange></li></modExtensions>
    <graphicData>
      <texPath>Things/Projectile/Grenade</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Bomb</damageDef>
      <damageAmountBase>0</damageAmountBase>
      <armorPenetrationBase>0.40</armorPenetrationBase>
      <speed>32</speed>
      <flyOverhead>true</flyOverhead>
      <explosionRadius>2.35</explosionRadius>
      <soundExplode>Explosion_Bomb</soundExplode>
    </projectile>
  </ThingDef>

