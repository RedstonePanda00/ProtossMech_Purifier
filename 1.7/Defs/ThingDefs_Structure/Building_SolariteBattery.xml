<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="BuildingBase">
        <defName>PM_SolariteBattery</defName>
        <label>Solarite battery</label>
        <description>This structure stores energy and can materialize it, encapsulating it as Solarite.</description>
        <thingClass>Building</thingClass>
        <tickerType>Normal</tickerType>
        <drawerType>MapMeshAndRealTime</drawerType>
        <graphicData>
            <texPath>Things/Structure/SolariteBattery</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(2,2)</drawSize>
        </graphicData>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <fillPercent>0.4</fillPercent>
        <pathCost>50</pathCost>
        <blockWind>true</blockWind>
        <castEdgeShadows>true</castEdgeShadows>
        <canOverlapZones>false</canOverlapZones>
        <rotatable>false</rotatable>
        <designationCategory>Power</designationCategory>
        <uiOrder>3020</uiOrder>
        <size>(1,1)</size>
        <statBases>
            <MaxHitPoints>150</MaxHitPoints>
            <WorkToBuild>4000</WorkToBuild>
            <Flammability>0</Flammability>
            <Beauty>-5</Beauty>
        </statBases>
        <costList>
            <Plasteel>100</Plasteel>
            <ComponentSpacer>10</ComponentSpacer>
        </costList>
        <researchPrerequisites><li>PM_EnergyCrystallization</li></researchPrerequisites>
        <comps>
      <li Class="ProtossMech.CompProperties_ProtossBuilding"/>
            <li Class="CompProperties_Power">
                <compClass>ProtossMech.CompPowerPlant_SolariteBattery</compClass>
                <basePowerConsumption>-1</basePowerConsumption>
                <transmitsPower>true</transmitsPower>
            </li>
            <li Class="ProtossMech.CompProperties_SolariteBatteryStorage">
                <!-- ceil(25 kg * c^2 / 0.95 / 1000 J per game Wd); matches SolariteBatteryEnergyUnits. -->
                <storedEnergyMax>2365145207202152</storedEnergyMax>
                <pylonChargePercentPerDay>0.50</pylonChargePercentPerDay>
                <maxOutputPower>100000</maxOutputPower>
                <outputPowerStep>100</outputPowerStep>
                <crystallizeThreshold>0.95</crystallizeThreshold>
                <crystallizeSolariteCount>25</crystallizeSolariteCount>
                <crystallizeProduct>PM_Solarite</crystallizeProduct>
            </li>
            <li Class="CompProperties_Flickable"/>
            <li Class="CompProperties_Breakdownable"/>
            <li Class="ProtossMech.CompProperties_ProtossMechShield">
                <energyMax>150</energyMax>
                <energyGainPerTick>0.2</energyGainPerTick>
                <ticksToBeginRecharge>600</ticksToBeginRecharge>
                <minDrawSize>1.2</minDrawSize>
                <maxDrawSize>2.0</maxDrawSize>
            </li>
        </comps>
        <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
        <constructEffect>ConstructMetal</constructEffect>
        <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    </ThingDef>

</Defs>
