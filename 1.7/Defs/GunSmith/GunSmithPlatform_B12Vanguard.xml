<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <GunSmithFramework.GunSmithPlatformDef>
        <defName>PM_GunSmith_B12Vanguard</defName>
        <supportsEliteGunsmith>true</supportsEliteGunsmith>
        <label>B12 Vanguard</label>
        <weaponThingDef>PM_GunB12Vanguard</weaponThingDef>
        <bodyTexPath>Things/Weapon/B12/B12_Body</bodyTexPath>
        <slotAttachmentOffsets>
            <li><slotId>Barrel</slotId><offset>(-0.3123, -0.0556)</offset><gizmoOffset>(0.0853, -0.3125)</gizmoOffset></li>
            <li><slotId>Laser</slotId><offset>(0, 0)</offset><gizmoOffset>(-1.0771, 0.2312)</gizmoOffset></li>
            <li><slotId>Stock</slotId><offset>(0.4110, -0.0414)</offset><gizmoOffset>(0.0084, -0.0494)</gizmoOffset></li>
            <li><slotId>Grip</slotId><offset>(0.1135, 0.0615)</offset><gizmoOffset>(-0.4960, 0.2470)</gizmoOffset></li>
            <!-- Magazine is dynamically provided by Barrel_03; this entry places its editor gizmo. -->
            <li><slotId>Magazine</slotId><offset>(0, 0)</offset><gizmoOffset>(-0.8126, 0.2622)</gizmoOffset></li>
            <li><slotId>Optic</slotId><offset>(-0.0083, -0.1610)</offset><gizmoOffset>(-0.5266, -0.2931)</gizmoOffset></li>
            <li><slotId>RearIronSight</slotId><offset>(0.0752, -0.1577)</offset></li>
            <li><slotId>FrontIronSight</slotId><offset>(0.1028, 0.0068)</offset></li>
        </slotAttachmentOffsets>
        <bakeTextureSize>512</bakeTextureSize>
        <bakePadding>0.05</bakePadding>
        <bakeContentScale>0.85</bakeContentScale>
        <shadowDilatePixels>5</shadowDilatePixels>
        <shadowAlpha>1</shadowAlpha>
        <slots>
            <li><slotId>Barrel</slotId><slotType>Barrel</slotType><optional>false</optional></li>
            <li><slotId>Laser</slotId><slotType>Laser</slotType><optional>true</optional></li>
            <li><slotId>Stock</slotId><slotType>Stock</slotType><optional>false</optional></li>
            <li><slotId>Grip</slotId><slotType>Grip</slotType><optional>false</optional></li>
            <li><slotId>Optic</slotId><slotType>Optic</slotType><optional>true</optional></li>
            <li><slotId>RearIronSight</slotId><slotType>RearIronSight</slotType><optional>false</optional></li>
            <li><slotId>FrontIronSight</slotId><slotType>FrontIronSight</slotType><optional>false</optional></li>
        </slots>
        <defaultParts>
            <li><slotId>Barrel</slotId><part>PM_B12Vanguard_Barrel_01</part></li>
            <li><slotId>Stock</slotId><part>PM_B12Vanguard_Stock_01</part></li>
            <li><slotId>Grip</slotId><part>PM_B12Vanguard_Grip_01</part></li>
            <li><slotId>Magazine</slotId><part>PM_B12Vanguard_Magazine_01</part></li>
            <li><slotId>Magazine</slotId><part>PM_B12Vanguard_Ammo_01</part></li>
            <li><slotId>RearIronSight</slotId><part>PM_Common_IronSight_Rear_Raised</part><whenSlotEmpty>Optic</whenSlotEmpty></li>
            <li><slotId>FrontIronSight</slotId><part>PM_Common_IronSight_Front_Raised</part><whenSlotEmpty>Optic</whenSlotEmpty></li>
            <li><slotId>RearIronSight</slotId><part>PM_Common_IronSight_Rear_Folded</part><whenSlotOccupied>Optic</whenSlotOccupied></li>
            <li><slotId>FrontIronSight</slotId><part>PM_Common_IronSight_Front_Folded</part><whenSlotOccupied>Optic</whenSlotOccupied></li>
        </defaultParts>
        
            <modExtensions>
            <li Class="ProtossMech.GunSmith.GunSmithContentExtension">
                <costList><li><thingDef>PM_Solarite</thingDef><count>50</count></li></costList>
            </li>
        </modExtensions>
    </GunSmithFramework.GunSmithPlatformDef>

</Defs>
