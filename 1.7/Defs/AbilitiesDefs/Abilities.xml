<?xml version="1.0" encoding="utf-8"?>

<Defs>
    <AbilityDef>
        <defName>MechForceFieldWall</defName>
        <abilityClass>ProtossMech.Ability_SupportEnergy</abilityClass>
        <label>shield recharge</label>
        <description>Restore 10 Protoss shield points per second to up to two allies within 8 cells. Costs 1% energy per second in total. Automatically used while drafted.</description>
        <iconPath>Gizmo/Sentry/ShieldRecharge</iconPath>
        <cooldownTicksRange>60</cooldownTicksRange><hostile>false</hostile><targetRequired>false</targetRequired>
        <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
        <verbProperties><verbClass>Verb_CastAbility</verbClass><warmupTime>0</warmupTime><range>8</range>
          <targetParams><canTargetSelf>true</canTargetSelf></targetParams>
        </verbProperties>
        <comps>
          <li Class="ProtossMech.CompProperties_SupportEnergy"><cost>0.01</cost><checkOnly>true</checkOnly></li>
          <li Class="ProtossMech.CompProperties_SentryRecharge" />
        </comps>
    </AbilityDef>

    <AbilityDef>
        <defName>PM_GuardianShield</defName>
        <abilityClass>ProtossMech.Ability_SupportEnergy</abilityClass>
        <label>Guardian Shield</label>
        <description>Spend 40% energy to project a field for 15 seconds. Incoming hostile projectiles retain 25% speed and deal 50% damage; after 1 second inside the field they fall and are destroyed.</description>
        <iconPath>Gizmo/Sentry/GuardianShield</iconPath>
        <cooldownTicksRange>300</cooldownTicksRange>
        <hostile>false</hostile>
        <targetRequired>false</targetRequired>
        <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <warmupTime>0</warmupTime>
            <targetParams>
                <canTargetSelf>true</canTargetSelf>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="ProtossMech.CompProperties_SupportEnergy"><cost>.4</cost></li>
            <li Class="ProtossMech.CompProperties_ApplyHediff">
                <targetType>Self</targetType>
                <hediffDefNames>
                    <li>PM_Hediff_GuardianShieldActive</li>
                </hediffDefNames>
            </li>
        </comps>
    </AbilityDef>

    <AbilityDef>
        <defName>PM_PhaseMode</defName>
        <abilityClass>ProtossMech.Ability_SupportEnergy</abilityClass>
        <label>Phase mode</label>
        <description>Enter phase mode to project a larger shield dome and automatically use Chrono Beam. Incoming hostile projectiles retain 25% speed and deal 50% damage; after 1 second inside the field they fall and are destroyed. Requires remaining energy. Cannot move while phased.</description>
        <iconPath>Gizmo/Energizer/PhaseMode</iconPath>
        <cooldownTicksRange>60</cooldownTicksRange>
        <hostile>false</hostile>
        <targetRequired>false</targetRequired>
        <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <warmupTime>0</warmupTime>
            <targetParams>
                <canTargetSelf>true</canTargetSelf>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="ProtossMech.CompProperties_SupportEnergy"><cost>0</cost><toggleHediff>PM_Hediff_EnergizerPhaseMode</toggleHediff></li>
            <li Class="ProtossMech.CompProperties_ToggleHediff">
                <hediffDefName>PM_Hediff_EnergizerPhaseMode</hediffDefName>
            </li>
        </comps>
    </AbilityDef>

    <AbilityDef>
        <defName>MechChronoBeam</defName>
        <abilityClass>ProtossMech.Ability_SupportEnergy</abilityClass>
        <label>Chrono Beam</label>
        <description>Spend 8% energy to accelerate the target’s time flow.</description>
        <iconPath>Gizmo/Energizer/ChronoBeam</iconPath>
        <cooldownTicksRange>60</cooldownTicksRange>
        <hostile>false</hostile>
        <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <range>30</range>
            <warmupTime>0.5</warmupTime>
            <requireLineOfSight>false</requireLineOfSight>
            <targetParams>
                <canTargetLocations>false</canTargetLocations>
                <canTargetSelf>false</canTargetSelf>
                <canTargetPawns>true</canTargetPawns>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="ProtossMech.CompProperties_SupportEnergy"><cost>.08</cost></li>
            <li Class="ProtossMech.CompProperties_ApplyHediff">
                <targetType>Target</targetType>

                <hediffDefNames>
                    <li>Hediff_TemporalSurge</li>
                </hediffDefNames>

                <projectileDefName>PM_ChronoBeamProjectile</projectileDefName>
            </li>
        </comps>
    </AbilityDef>

    <AbilityDef>
        <defName>PM_HavocTargetLock</defName>
        <label>target lock</label>
        <description>Lock onto a hostile target. While locked, that target takes increased damage from all sources. Only one target at a time.</description>
        <iconPath>Gizmo/Havoc/TargetLock</iconPath>
        <cooldownTicksRange>120</cooldownTicksRange>
        <hostile>true</hostile>
        <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <warmupTime>0.25</warmupTime>
            <range>50</range>
            <requireLineOfSight>true</requireLineOfSight>
            <targetParams>
                <canTargetPawns>true</canTargetPawns>
                <canTargetSelf>false</canTargetSelf>
                <canTargetLocations>false</canTargetLocations>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="ProtossMech.CompProperties_AbilityTargetLock" />
        </comps>
        <modExtensions>
            <li Class="ProtossMech.AbilityExtension_TargetLockSettings">
                <maxLockRangeCells>50</maxLockRangeCells>
                <incomingDamageMultiplier>1.3</incomingDamageMultiplier>
            </li>
        </modExtensions>
    </AbilityDef>

    <AbilityDef>
        <defName>LegionnaireJump</defName>
