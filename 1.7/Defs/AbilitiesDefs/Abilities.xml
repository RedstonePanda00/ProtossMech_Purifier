    <AbilityDef>
        <defName>PM_CosmicSpider_Discharge</defName>
        <label>Discharge</label>
        <description>Create a psionic storm within 18 tiles of the caster for 4 seconds. Each 20-tick damage round deals 10 heat damage with 200% armor penetration to non-allied pawns and buildings. Conductive web floors retain the storm for 1 extra second. When the main storm ends, the bound enemy receives a radius-3 storm lasting 1 second, with damage every 5 ticks.</description>
        <iconPath>Gizmo/CosmicSpider/Discharge</iconPath>
        <cooldownTicksRange>3600</cooldownTicksRange>
        <hostile>true</hostile>
        <groupAbility>true</groupAbility>
        <targetRequired>false</targetRequired>
        <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <warmupTime>0</warmupTime>
            <range>18</range>
            <drawHighlightWithLineOfSight>false</drawHighlightWithLineOfSight>
            <targetParams>
                <canTargetSelf>true</canTargetSelf>
                <canTargetLocations>false</canTargetLocations>
                <canTargetPawns>false</canTargetPawns>
                <canTargetBuildings>false</canTargetBuildings>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="ProtossMech.CompProperties_CosmicSpiderDischarge">
                <radius>18</radius>
            </li>
        </comps>
    </AbilityDef>

    <AbilityDef>
        <defName>PM_CosmicSpider_WebSwing</defName>
        <label>Web Swing</label>
        <description>Swing from an anchor point to a destination with web-assisted mobility.</description>
        <iconPath>Gizmo/CosmicSpider/Swing</iconPath>
        <cooldownTicksRange>300</cooldownTicksRange>
        <hostile>false</hostile>
        <groupAbility>true</groupAbility>
        <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <warmupTime>0.1</warmupTime>
            <range>7</range>
            <targetParams>
                <canTargetLocations>true</canTargetLocations>
                <canTargetPawns>false</canTargetPawns>
                <canTargetBuildings>false</canTargetBuildings>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="ProtossMech.CompProperties_CosmicSpiderWebSwing">
                <jumpRangeCells>7</jumpRangeCells>
                <anchorRangeCells>18</anchorRangeCells>
                <chargeTicks>60</chargeTicks>
                <swingFlightTicks>240</swingFlightTicks>
                <swingPhysics>
                    <mass>1.0</mass>
                    <webCompliance>0.0008</webCompliance>
                    <webDamping>0.08</webDamping>
                    <webElasticStretchLimit>0.08</webElasticStretchLimit>
                    <webConstraintIterations>2</webConstraintIterations>
                    <globalDrag>0.003</globalDrag>
                    <verticalDrag>0.001</verticalDrag>
                    <quadraticDrag>0.0008</quadraticDrag>
                    <maneuverAcceleration>0.015</maneuverAcceleration>
                    <activeSwingPower>0.035</activeSwingPower>
                    <maxTangentialForce>0.35</maxTangentialForce>
                    <launchReferenceTicks>15</launchReferenceTicks>
                    <launchVelocityScale>1.65</launchVelocityScale>
                    <launchVerticalVelocity>0.28</launchVerticalVelocity>
                    <launchArcHeightCells>1.2</launchArcHeightCells>
                    <minLaunchSpeed>0.65</minLaunchSpeed>
                    <radiusAdjustStep>1.25</radiusAdjustStep>
                    <minWebLength>2.0</minWebLength>
                    <maxWebLength>36.0</maxWebLength>
                    <anchorHeightCells>-1.0</anchorHeightCells>
                    <reelSpeed>0.22</reelSpeed>
                    <reelAcceleration>0.035</reelAcceleration>
                    <reelMotorPower>0.09</reelMotorPower>
                    <maxReelForce>0.9</maxReelForce>
                    <releaseMaxDistance>80.0</releaseMaxDistance>
                    <releaseMinFlightTicks>4</releaseMinFlightTicks>
                    <releaseMaxFlightTicks>180</releaseMaxFlightTicks>
                    <groundFriction>0.06</groundFriction>
                    <groundSlideStopSpeed>0.18</groundSlideStopSpeed>
                    <groundSlideMinTicks>8</groundSlideMinTicks>
                    <gravityAcceleration>0.035</gravityAcceleration>
                    <numericalVelocityCap>20.0</numericalVelocityCap>
                    <simulationSubsteps>4</simulationSubsteps>
                </swingPhysics>
            </li>
        </comps>
    </AbilityDef>

</Defs>
