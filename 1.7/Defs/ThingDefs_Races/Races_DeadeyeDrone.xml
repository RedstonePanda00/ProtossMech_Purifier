<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ProtossMechanoid">
    <defName>PM_DeadeyeDrone</defName>
    <label>Deadeye drone</label>
    <description>The Deadeye is a converted Servitor armed with a beam cannon. Its anti-gravity core enables aerial long-range sniping, providing accompanying anti-vehicle air support.</description>
    <statBases><MoveSpeed>8</MoveSpeed><ArmorRating_Blunt>0.5</ArmorRating_Blunt><ArmorRating_Sharp>0.65</ArmorRating_Sharp><BandwidthCost>2</BandwidthCost><MarketValue>1800</MarketValue></statBases>
    <race>
      <body>PM_ProbeBody</body><baseBodySize>1</baseBodySize><baseHealthScale>1.5</baseHealthScale>
      <mechEnabledWorkTypes><li>Hauling</li></mechEnabledWorkTypes><mechFixedSkillLevel>10</mechFixedSkillLevel>
      <lifeStageAges><li><def>MechanoidFullyFormed</def><minAge>0</minAge><soundWounded>Pawn_Mech_Constructoid_Wounded</soundWounded><soundDeath>Pawn_Mech_Constructoid_Death</soundDeath><soundCall>Pawn_Mech_Constructoid_Call</soundCall></li></lifeStageAges>
    </race>
    <tools Inherit="False"><li><label>frame</label><capacities><li>Blunt</li></capacities><power>5</power><cooldownTime>1.5</cooldownTime><linkedBodyPartsGroup>Torso</linkedBodyPartsGroup><ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable></li></tools>
    <comps>
      <li Class="ProtossMech.CompProperties_ProtossMechShield"><energyMax>60</energyMax><energyGainPerTick>0.25</energyGainPerTick><ticksToBeginRecharge>600</ticksToBeginRecharge><minDrawSize>0</minDrawSize><maxDrawSize>2</maxDrawSize></li>
      <li Class="RsPandaLibrary.CompProperties_EnsureHediffList"><hediffDefs><li>PM_Floating</li></hediffDefs><checkInterval>240</checkInterval></li>
      <li Class="RsPandaLibrary.CompProperties_MultiTurretGun">
        <saveKeysPrefix>PM_Deadeye_</saveKeysPrefix>
        <turrets><li>
          <turretDef>PM_Gun_DeadeyeBeam</turretDef><warmupTime>1.5</warmupTime><cooldownTime>3.5</cooldownTime>
          <turretOffsetDefault>(0,0,-0.25)</turretOffsetDefault>
          <turretOffsetEast>(0.12,0,-0.22)</turretOffsetEast><turretOffsetWest>(-0.12,0,-0.22)</turretOffsetWest>
          <renderNodeProperties>
            <nodeClass>RsPandaLibrary.PawnRenderNode_MultiTurretGun</nodeClass><workerClass>RsPandaLibrary.PawnRenderNodeWorker_MultiTurretGun</workerClass>
            <parentTagDef>Body</parentTagDef><pawnType>Any</pawnType><baseLayer>60</baseLayer><drawSize>(0.85,0.85)</drawSize><overrideMeshSize>(0.85,0.85)</overrideMeshSize>
            <drawData><defaultData><rotationOffset>-90</rotationOffset></defaultData><dataNorth><layer>-5</layer></dataNorth></drawData>
            <debugLabel>Deadeye beam cannon</debugLabel>
          </renderNodeProperties>
        </li></turrets>
      </li>
    </comps>
  </ThingDef>
  <PawnKindDef ParentName="ProtossMechanoidKind">
    <defName>PM_DeadeyeDrone</defName><label>Deadeye drone</label><race>PM_DeadeyeDrone</race><combatPower>100</combatPower>
    <lifeStages><li><bodyGraphicData><texPath>Things/Pawn/Mechanoid/Deadeye/Deadeye</texPath><shaderType>Cutout</shaderType><drawSize>1.25</drawSize></bodyGraphicData></li></lifeStages>
  </PawnKindDef>
</Defs>
