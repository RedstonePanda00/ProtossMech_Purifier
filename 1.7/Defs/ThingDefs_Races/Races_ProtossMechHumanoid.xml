<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!-- Legionnaire -->
  <ThingDef ParentName="ProtossMechanoid">
    <defName>PM_Legionnaire</defName>
    <label>Legionnaire</label>
    <description>Legionnaires are among the earliest products of the Purifier Program. Their neural patterns were replicated from the consciousness of the greatest Templar warriors of antiquity. \n\n Following their activation, the Legionnaires participated in numerous brutal campaigns before their involvement in the Great Purifier Rebellion—a conflict that inflicted grievous losses upon the Protoss Empire and led to the indefinite deactivation of the entire Purifier Program. Despite this history, they remain invaluable soldiers, each possessing tens of thousands of years of combat experience.</description>
    <statBases>
      <BandwidthCost>3</BandwidthCost>
      <ArmorRating_Blunt>1.5</ArmorRating_Blunt>
      <ArmorRating_Sharp>1.5</ArmorRating_Sharp>
      <MoveSpeed>6.5</MoveSpeed>
      <IncomingDamageFactor>0.5</IncomingDamageFactor>
      <RangedCooldownFactor>0.5</RangedCooldownFactor>
      <AimingDelayFactor>0.5</AimingDelayFactor>
      <ShootingAccuracyPawn>12</ShootingAccuracyPawn>
      <ShootingAccuracyFactor_Medium>1.5</ShootingAccuracyFactor_Medium>
      <ShootingAccuracyFactor_Long>1.5</ShootingAccuracyFactor_Long>
    </statBases>
    <race>
      <body>PM_HumanoidBody</body>
      <baseBodySize>2</baseBodySize>
      <mechEnabledWorkTypes>
        <li>Hauling</li>
        <li>Cleaning</li>
        <li>Hunting</li>
        <li>Firefighter</li>
      </mechEnabledWorkTypes>
      <soundMeleeHitPawn>Pawn_Melee_MechanoidSlash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_MechanoidSlash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_MechanoidSlash_Miss</soundMeleeMiss>
      <lifeStageAges>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Mech_Scyther_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Scyther_Death</soundDeath>
          <soundCall>Pawn_Mech_Scyther_Call</soundCall>
        </li>
      </lifeStageAges>
      <baseHealthScale>5.0</baseHealthScale>
    </race>
    <butcherProducts>
      <PM_Adanium>100</PM_Adanium>
    </butcherProducts>

    <tools>
      <li>
        <label>left Energy Blade</label>
        <capacities>
          <li>Cut</li>
          <li>Stab</li>
        </capacities>
        <power>16</power>
        <cooldownTime>1.0</cooldownTime>
        <armorPenetration>1.5</armorPenetration>
      </li>
      <li>
        <label>right Energy Blade</label>
        <capacities>
          <li>Cut</li>
          <li>Stab</li>
        </capacities>
        <power>16</power>
        <cooldownTime>1.0</cooldownTime>
        <armorPenetration>1.5</armorPenetration>
      </li>
    </tools>

    <comps>
      <li Class="ProtossMech.CompProperties_ProtossMechShield">
        <energyMax>100</energyMax>
        <energyGainPerTick>0.25</energyGainPerTick>
        <ticksToBeginRecharge>600</ticksToBeginRecharge>
        <minDrawSize>0</minDrawSize>
        <maxDrawSize>2</maxDrawSize>
      </li>
      <li Class="ProtossMech.CompProperties_PurifierReconstruct">
        <cooldownTicks>3600</cooldownTicks>
        <reconstructHediff>Hediff_Reconstruct</reconstructHediff>
      </li>
      <li Class="RsPandaLibrary.CompProperties_EquippableMechanoid" />
    </comps>

    <modExtensions>
        <li Class="RsPandaLibrary.Compatibility.RimTalk.RimTalkPersonaExtension">
            <personaKeys>
                <li>Protoss_Persona_Legionnaire_Conclave</li>
                <li>Protoss_Persona_Legionnaire_Fleet</li>
                <li>Protoss_Persona_Legionnaire_Vanguard</li>
            </personaKeys>
            <chattiness>0.5</chattiness>
        </li>
    </modExtensions>
  </ThingDef>

  <PawnKindDef ParentName="ProtossMechanoidKind">
    <defName>PM_Legionnaire</defName>
    <label>Legionnaire</label>
    <race>PM_Legionnaire</race>
    <combatPower>42</combatPower>
    <allowInMechClusters>false</allowInMechClusters>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Mechanoid/Legionnaire</texPath>
          <shaderType>Cutout</shaderType>
          <drawSize>2.0</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
    <abilities>
      <li>MechCharge</li>
    </abilities>
  </PawnKindDef>

  <!-- Sentinel -->
  <ThingDef ParentName="ProtossMechanoid">
    <defName>PM_Sentinel</defName>
    <label>Sentinel</label>
    <description>The Sentinels originated from an offshoot of the Purifier Project, employing positronic AI as an ethical alternative to digital neural patterns transfer. Even if destroyed, they can be rapidly reassembled by reconstruction drones.</description>
    <statBases>
      <BandwidthCost>2</BandwidthCost>
      <ArmorRating_Blunt>0.7</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.7</ArmorRating_Sharp>
      <MoveSpeed>6.0</MoveSpeed>
    </statBases>
    <race>
      <body>PM_HumanoidBody</body>
      <baseBodySize>1</baseBodySize>
      <mechEnabledWorkTypes>
        <li>Hauling</li>
        <li>Cleaning</li>
        <li>Hunting</li>
        <li>Firefighter</li>
      </mechEnabledWorkTypes>
      <soundMeleeHitPawn>Pawn_Melee_MechanoidSlash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_MechanoidSlash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_MechanoidSlash_Miss</soundMeleeMiss>
      <lifeStageAges>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Mech_Scyther_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Scyther_Death</soundDeath>
          <soundCall>Pawn_Mech_Scyther_Call</soundCall>
        </li>
      </lifeStageAges>
      <baseHealthScale>2.5</baseHealthScale>
    </race>
    <butcherProducts>
      <Plasteel>25</Plasteel>
    </butcherProducts>

    <tools>
      <li>
        <label>left Energy Blade</label>
        <capacities>
          <li>Cut</li>
          <li>Stab</li>
        </capacities>
        <power>8</power>
        <cooldownTime>1.0</cooldownTime>
        <armorPenetration>0.75</armorPenetration>
      </li>
      <li>
        <label>right Energy Blade</label>
        <capacities>
          <li>Cut</li>
          <li>Stab</li>
        </capacities>
        <power>8</power>
        <cooldownTime>1.0</cooldownTime>
        <armorPenetration>0.75</armorPenetration>
      </li>
    </tools>

    <comps>
      <li Class="ProtossMech.CompProperties_ProtossMechShield">
        <energyMax>50</energyMax>
        <energyGainPerTick>0.25</energyGainPerTick>
        <ticksToBeginRecharge>600</ticksToBeginRecharge>
        <minDrawSize>0</minDrawSize>
        <maxDrawSize>2</maxDrawSize>
      </li>
      <li Class="ProtossMech.CompProperties_PurifierReconstruct">
        <cooldownTicks>3600</cooldownTicks>
        <reconstructHediff>Hediff_Reconstruct</reconstructHediff>
      </li>
      <li Class="RsPandaLibrary.CompProperties_EquippableMechanoid" />
    </comps>
    <modExtensions>
        <li Class="RsPandaLibrary.Compatibility.RimTalk.RimTalkPersonaExtension">
            <personaKeys>
                <li>Protoss_Persona_Sentinel</li>
            </personaKeys>
            <chattiness>0.25</chattiness>
        </li>
    </modExtensions>
  </ThingDef>

  <PawnKindDef ParentName="ProtossMechanoidKind">
    <defName>PM_Sentinel</defName>
    <label>Sentinel</label>
    <race>PM_Sentinel</race>
    <combatPower>42</combatPower>
    <allowInMechClusters>false</allowInMechClusters>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Mechanoid/Sentinel</texPath>
          <shaderType>Cutout</shaderType>
          <drawSize>1.5</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
    <abilities>
      <li>MechCharge</li>
    </abilities>
  </PawnKindDef>

  <!-- Umbra -->
  <ThingDef ParentName="PM_SyntheticColonistBase">
    <defName>PM_Umbra</defName>
    <label>Umbra</label>
    <description>The Umbra chassis was personally designed by Executor Sigmar to meet the needs of specialized infiltration operations.\n\nEvery Umbra is a member of the Star Devourers, one of Sigmar's personal guards, and an elite among elites.\n\nTheir bodies consist entirely of nanite swarms, rendering them almost immune to all physical attacks while granting them extraordinary mobility and infiltration capabilities.</description>
    <statBases>
      <ArmorRating_Blunt>1.5</ArmorRating_Blunt>
      <ArmorRating_Sharp>1.5</ArmorRating_Sharp>
      <MoveSpeed>3.9</MoveSpeed>
      <MeleeHitChance>100.0</MeleeHitChance>
      <IncomingDamageFactor>0.50</IncomingDamageFactor>
      <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">1</VacuumResistance>
      <MeleeDodgeChance>95</MeleeDodgeChance>
      <AimingDelayFactor>0.25</AimingDelayFactor>
      <ShootingAccuracyPawn>12</ShootingAccuracyPawn>
    </statBases>
    <race>
      <body>PM_UmbraBody</body>
      <renderTree>PM_Umbra</renderTree>
      <nameGenerator>PM_NamerUmbra</nameGenerator>
      <baseBodySize>1.2</baseBodySize>
      <soundMeleeHitPawn>Pawn_Melee_MechanoidSlash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_MechanoidSlash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_MechanoidSlash_Miss</soundMeleeMiss>
      <lifeStageAges>
        <li>
          <def>PM_SyntheticAdult</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Mech_Scyther_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Scyther_Death</soundDeath>
          <soundCall>Pawn_Mech_Scyther_Call</soundCall>
        </li>
      </lifeStageAges>
      <baseHealthScale>2.0</baseHealthScale>
    </race>
    <butcherProducts>
      <PM_Adanium>125</PM_Adanium>
    </butcherProducts>

    <tools>
      <li>
        <label>Warp blade</label>
        <capacities>
          <li>Cut</li>
          <li>Stab</li>
        </capacities>
        <power>45</power>
        <cooldownTime>1.2</cooldownTime>
        <armorPenetration>2.0</armorPenetration>
      </li>
    </tools>

    <comps>
      <li Class="ProtossMech.CompProperties_ProtossMechShield">
        <energyMax>80</energyMax>
        <energyGainPerTick>0.25</energyGainPerTick>
        <ticksToBeginRecharge>400</ticksToBeginRecharge>
        <minDrawSize>0</minDrawSize>
        <maxDrawSize>1.5</maxDrawSize>
      </li>
      <li Class="ProtossMech.CompProperties_PurifierReconstruct">
        <cooldownTicks>3600</cooldownTicks>
        <reconstructHediff>Hediff_Reconstruct</reconstructHediff>
      </li>
      <li Class="ProtossMech.CompProperties_UmbraWarpBladeRenderer" />
      <li Class="ProtossMech.CompProperties_UmbraTripleStrikeGunOverlay" />
      <li Class="ProtossMech.Slash.CompProperties_UmbraSlash">
        <tuning>
          <fadeDamage>24</fadeDamage>
        <fadeIncome>12</fadeIncome>
        <fadeStepDistance>1</fadeStepDistance>
        <spiritStepDamage>40</spiritStepDamage>
        <spiritStepCost>15</spiritStepCost>
        <spiritStepDistance>1</spiritStepDistance>
        <focusChordWindow>0.15</focusChordWindow>
        <sprintTravel>0.11</sprintTravel>
        <sprintRepeatPause>0.19</sprintRepeatPause>
        <helmJumpHeight>9</helmJumpHeight>
        <helmFlashHeight>13.5</helmFlashHeight>
        <releaseArcScale>1.85</releaseArcScale>
        <releaseArcWidth>3</releaseArcWidth>
        <releaseArcLife>0.48</releaseArcLife>
        <releaseSparkCount>84</releaseSparkCount>
        <releaseSparkSpeed>1</releaseSparkSpeed>
        <chargeSparkCount>96</chargeSparkCount>
        <offsetSparkCount>180</offsetSparkCount>
        <offsetSparkLengthScale>1.65</offsetSparkLengthScale>
        <offsetSparkHalfWidth>0.22</offsetSparkHalfWidth>
        <spiritChargeDuration>3</spiritChargeDuration>
        <spiritChargeMoveMultiplier>0.5</spiritChargeMoveMultiplier>
        <spiritChargeGaugePerSecond>33.333334</spiritChargeGaugePerSecond>
          <focusTurnSpeed>720</focusTurnSpeed>
          <focusRollDistance>2</focusRollDistance>
          <focusRollDuration>0.4</focusRollDuration>
          <focusRollInvulnerability>0.1</focusRollInvulnerability>
          <focusOffsetGpWindow>0.2</focusOffsetGpWindow>
          <focusPeerlessLimit>24</focusPeerlessLimit>
          <focusPeerlessTimeout>1</focusPeerlessTimeout>
          <hyperArmorDamageCap>1</hyperArmorDamageCap>
          <hitHealthRestore>5</hitHealthRestore>
          <hitShieldRestore>5</hitShieldRestore>
        </tuning>
      </li>
    </comps>

    <modExtensions>
      <li Class="ProtossMech.SyntheticColonistExtension">
        <childhood>PM_UmbraChildhood</childhood>
        <adulthood>PM_UmbraAdulthood</adulthood>
        <xenotype>PM_UmbraXenotype</xenotype>
        <requiredGene>PM_NaniteSwarm</requiredGene>
        <generationAge>190~210</generationAge>
      </li>
        <li Class="RsPandaLibrary.Compatibility.RimTalk.RimTalkPersonaExtension">
            <personaKeys>
                <li>Protoss_Persona_Umbra</li>
            </personaKeys>
            <chattiness>0.15</chattiness>
        </li>
    </modExtensions>
  </ThingDef>

  <PawnKindDef>
    <defName>PM_Umbra</defName>
    <label>Umbra</label>
    <race>PM_Umbra</race>
    <combatPower>42</combatPower>
    <defaultFactionDef>PlayerColony</defaultFactionDef>
    <fixedGender>Male</fixedGender>
    <initialResistanceRange>13~21</initialResistanceRange>
    <initialWillRange>0~0</initialWillRange>
    <minGenerationAge>190</minGenerationAge>
    <maxGenerationAge>210</maxGenerationAge>
    <chronologicalAgeRange>190~210</chronologicalAgeRange>
    <backstoryFiltersOverride><li><categories><li>PM_UmbraOnly</li></categories></li></backstoryFiltersOverride>
    <fixedChildBackstories><li>PM_UmbraChildhood</li></fixedChildBackstories>
    <fixedAdultBackstories><li>PM_UmbraAdulthood</li></fixedAdultBackstories>
    <requiredWorkTags><li>Violent</li></requiredWorkTags>
    <apparelMoney>0</apparelMoney>
    <weaponMoney>0</weaponMoney>
    <techHediffsMoney>0</techHediffsMoney>
    <chemicalAddictionChance>0</chemicalAddictionChance>
    <destroyGearOnDrop>false</destroyGearOnDrop>
    <allowInMechClusters>false</allowInMechClusters>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Mechanoid/Umbra</texPath>
          <shaderType>Transparent</shaderType>
          <drawSize>1.5</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
    <abilities>
      <li>PM_UmbraSkip</li>
      <li>PM_UmbraTripleStrike</li>
      <li>PM_UmbraFlash</li>
    </abilities>
  </PawnKindDef>

</Defs>
